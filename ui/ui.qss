/* style.qss
   UI 样式集中管理：方便维护、方便换主题
   -------------------------------------------------
   说明：
   - 牌名 QLabel：objectName = "CardNameLabel"
   - 数量 QLabel：objectName = "CardCountLabel"
   - depleted 状态：dynamicProperty depleted=true/false
     通过 QSS 属性选择器匹配：
     QLabel#CardNameLabel[depleted="true"] { ... }
*/

/* 全局默认：统一基础字体 */
QWidget {
    font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC";
    font-size: 14px;
}


/* 主窗口标题栏与无文字操作图标 */
QWidget#MainTitleBar {
    background-color: palette(window);
}

/* 基本设置中的一级布局模式与缩进后的二级配置区 */
QPushButton#LayoutModeButton {
    padding: 6px 14px;
    border: 1px solid palette(mid);
    border-radius: 6px;
}

QPushButton#LayoutModeButton:checked {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border-color: palette(highlight);
}

QFrame#LayoutModeDetails {
    border: none;
}

QGroupBox#LayoutSettingsGroup {
    background-color: palette(window);
    border: 1px solid palette(mid);
    border-radius: 7px;
}

QLabel#AutoLayoutWindowTitle {
    padding-left: 4px;
}

QLabel#MainTitleBarCaption {
    font-weight: 400;
    font-size: 12px;
    padding-left: 5px;
}

QToolButton#MainTitleBarAction {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 3px;
}

QToolButton#MainTitleBarAction:hover {
    background-color: rgba(127, 127, 127, 50);
}

QToolButton#MainTitleBarAction:pressed {
    background-color: rgba(127, 127, 127, 85);
}

QPushButton#MainTitleBarRetry {
    font-size: 11px;
    padding: 0 6px;
}

/* 牌名：默认样式 */
QLabel#CardNameLabel {
    font-size: 14px;
    font-weight: 600;
    padding: 2px 4px;
}

/* 牌名 depleted：变灰 */
QLabel#CardNameLabel[depleted="true"] {
    font-size: 14px;
    font-weight: 600;
    color: #999;
    padding: 2px 4px;
}

/* 数量：默认样式 */
QLabel#CardCountLabel {
    font-size: 14px;
    padding: 1px 4px;
    border-radius: 6px;
}

/* 数量等于4时显示为淡红色 */
QLabel#CardCountLabel[count="4"] {
    font-size: 14px;
    padding: 1px 4px;
    border-radius: 6px;
    color: #ff6666;
}

/* 数量 depleted：变灰 */
QLabel#CardCountLabel[depleted="true"] {
    font-size: 14px;
    padding: 1px 4px;
    border-radius: 6px;
    color: #999;
}

/* 两块内容同底色，仅在出牌区靠牌数一侧绘制一条分隔线。 */
QFrame#CardCountPanel, QFrame#PlayedCardsPanel {
    border: none;
    border-radius: 0;
    background-color: transparent;
}

QFrame#PlayedCardsPanel[arrangement="vertical"] {
    border-top: 1px solid palette(mid);
}

QFrame#PlayedCardsPanel[arrangement="horizontal"] {
    border-left: 1px solid palette(mid);
}

QLabel#InfoLabel {
    padding: 0;
    border: none;
}

/* 标题栏短状态与布局编辑器：跟随系统明暗主题。 */
QLabel#MainTitleBarStatus { font-size: 11px; font-weight: 400; padding-left: 5px; padding-right: 3px; }
QDialog#LayoutEditorDialog QGroupBox { border: 1px solid palette(mid); border-radius: 8px; margin-top: 12px; padding: 12px; }
QDialog#LayoutEditorDialog QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; }
QLabel#LayoutEditorHint { color: palette(text); font-size: 12px; }
QPushButton#LayoutEditorSave { padding: 6px 20px; font-weight: 600; }
